# Copy this file to .env only on the server. Never commit .env.
TRACKER_API_TOKEN=replace-with-a-long-random-token
TRACKER_DB_PATH=/data/tracker.db
TRACKER_PORT=8080
TRACKER_REFRESH_HOUR=7
TRACKER_REFRESH_MINUTE=30
